{
  "name": "@minglesai/marketclaw",
  "version": "0.1.0",
  "description": "AI marketing team orchestration plugin for OpenClaw — Strategist, Creator, Reviewer, Publisher, Analyst pipeline",
  "type": "module",
  "license": "MIT",
  "author": "Mingles AI <hello@mingles.ai>",
  "repository": {
    "type": "git",
    "url": "https://github.com/MinglesAI/marketclaw.git"
  },
  "bugs": {
    "url": "https://github.com/MinglesAI/marketclaw/issues"
  },
  "homepage": "https://github.com/MinglesAI/marketclaw#readme",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "marketing",
    "ai-marketing",
    "content-pipeline",
    "orchestration",
